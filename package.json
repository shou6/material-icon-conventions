{
  "name": "material-icon-conventions",
  "displayName": "Material Icon Conventions",
  "description": "%description%",
  "version": "0.1.1",
  "publisher": "shou6",
  "license": "MIT",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#1F2937",
    "theme": "dark"
  },
  "homepage": "https://github.com/shou6/material-icon-conventions#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/shou6/material-icon-conventions.git"
  },
  "bugs": {
    "url": "https://github.com/shou6/material-icon-conventions/issues"
  },
  "private": true,
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "material-icon-theme",
    "material-icons",
    "icons",
    "icon-theme",
    "file-icons",
    "folder-icons",
    "icon-associations",
    "file-associations",
    "folder-associations",
    "naming-conventions",
    "mock",
    "fixture"
  ],
  "files": [
    "resources/**",
    "package.nls.json",
    "package.nls.ja.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "extensionDependencies": [
    "PKief.material-icon-theme"
  ],
  "contributes": {
    "configurationDefaults": {
      "material-icon-theme.files.associations": {
        "*.mock.ts": "test-ts",
        "*.mock.js": "test-js",
        "*.mock.mjs": "test-js",
        "*.mock.tsx": "test-jsx",
        "*.mock.jsx": "test-jsx",
        "*.mock.mts": "test-ts",
        "*.mock.cts": "test-ts",
        "*.mock.cjs": "test-js",
        "*.mocks.ts": "test-ts",
        "*.mocks.js": "test-js",
        "*.mocks.mts": "test-ts",
        "*.mocks.cts": "test-ts",
        "*.mocks.mjs": "test-js",
        "*.mocks.cjs": "test-js",
        "*.fixture.ts": "test-ts",
        "*.fixture.js": "test-js",
        "*.fixture.mts": "test-ts",
        "*.fixture.cts": "test-ts",
        "*.fixture.mjs": "test-js",
        "*.fixture.cjs": "test-js",
        "*.fixtures.ts": "test-ts",
        "*.fixtures.js": "test-js",
        "*.fixtures.mts": "test-ts",
        "*.fixtures.cts": "test-ts",
        "*.fixtures.mjs": "test-js",
        "*.fixtures.cjs": "test-js",
        "*.stub.ts": "test-ts",
        "*.stub.js": "test-js",
        "*.stub.mts": "test-ts",
        "*.stub.cts": "test-ts",
        "*.stub.mjs": "test-js",
        "*.stub.cjs": "test-js",
        "*.fake.ts": "test-ts",
        "*.fake.js": "test-js",
        "*.fake.mts": "test-ts",
        "*.fake.cts": "test-ts",
        "*.fake.mjs": "test-js",
        "*.fake.cjs": "test-js",
        "*.e2e.ts": "test-ts",
        "*.e2e.js": "test-js",
        "*.e2e.tsx": "test-jsx",
        "*.e2e.mts": "test-ts",
        "*.e2e.cts": "test-ts",
        "*.e2e.mjs": "test-js",
        "*.e2e.cjs": "test-js",
        "*.e2e.jsx": "test-jsx",
        ".blerc": "console",
        ".claudeignore": "claude",
        "*.lnk": "url",
        "*.iss": "installation",
        "*.mako": "python-misc",
        "*.agent.md": "agent",
        "*.chatmode.md": "agent"
      },
      "material-icon-theme.folders.associations": {
        "testdata": "test",
        "test-data": "test",
        "test_data": "test",
        "stubs": "mock",
        "stub": "mock",
        "fakes": "mock",
        "fake": "mock",
        "dummies": "mock",
        "dummy": "mock",
        "factories": "generator",
        "factory": "generator",
        "endpoints": "api",
        "endpoint": "api",
        "openapi": "api",
        "swagger": "api",
        "webhooks": "api",
        "webhook": "api",
        "workers": "job",
        "worker": "job",
        "cron": "job",
        "crons": "job",
        "cronjobs": "job",
        "cronjob": "job",
        "schedulers": "job",
        "scheduler": "job",
        "listeners": "event",
        "listener": "event",
        "subscribers": "event",
        "subscriber": "event",
        "observers": "event",
        "observer": "event",
        "emitters": "event",
        "third_party": "lib",
        "mappers": "mappings",
        "mapper": "mappings",
        "serializers": "mappings",
        "transformers": "mappings",
        "permissions": "secure",
        "authorization": "secure",
        "exceptions": "error",
        "exception": "error",
        "logger": "log",
        "loggers": "log",
        "sockets": "connection",
        "socket": "connection",
        "websocket": "connection",
        "websockets": "connection",
        "datasets": "database",
        "dataset": "database",
        "postgres": "database",
        "postgresql": "database",
        "mysql": "database",
        "mariadb": "database",
        "sqlite": "database",
        "mongodb": "database",
        "mongo": "database",
        "mssql": "database",
        "sqlserver": "database",
        "csv": "database",
        "alembic": "migrations",
        "foundation": "base",
        "capabilities": "secure",
        "popup": "views",
        ".wxt": "temp",
        ".browser-profile": "temp",
        "chatmodes": "robot"
      },
      "material-icon-theme.folders.customClones": [
        {
          "name": "installer",
          "base": "packages",
          "color": "amber-600",
          "folderNames": [
            "installer",
            "installers"
          ]
        },
        {
          "name": "entrypoints",
          "base": "app",
          "color": "teal-400",
          "folderNames": [
            "entrypoints"
          ]
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run check-types && npm run lint",
    "watch": "tsc --noEmit --watch --project tsconfig.json",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && mocha",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\" \"*.{js,mjs,json}\" \".vscode/*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{js,mjs,json}\" \".vscode/*.json\"",
    "test": "vscode-test",
    "test:integration:local": "node scripts/test-integration-local.js",
    "vsix": "vsce package",
    "try": "node scripts/try-extension.js",
    "test:unit": "npm run compile-tests && mocha",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "verify:package": "node scripts/verify-package.js",
    "icon": "node scripts/generate-icon.js",
    "check:candidates": "node scripts/check-candidates.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "markdownlint-cli2": "^0.23.3",
    "material-icon-theme": "^5.38.1",
    "mocha": "^11.8.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
